          "required": true,
          "ui:widget": "text",
          "ui:placeholder": "e.g. Admissions Head, Principal",
          "ui:disabled": false
        },
        "whoIAm": {
          "type": "object",
          "title": "Who I Am",
          "description": "Institution and representative details",
          "properties": {
            "institutionName": {
              "type": "string",
              "title": "Institution Name",
              "description": "Full name of the institution",
              "required": true,
              "ui:widget": "text",
              "ui:placeholder": "Enter institution name",
              "ui:disabled": false
            },
            "cityAndPincode": {
              "type": "string",
              "title": "City / Campus Location + Pincode",
              "description": "City and pincode of the main campus",
              "required": true,
              "ui:widget": "text",
              "ui:placeholder": "Enter city and pincode",
              "ui:disabled": false,
              "ui:hasLocationButton": true
