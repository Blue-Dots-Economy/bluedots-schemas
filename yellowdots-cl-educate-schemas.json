    "hei": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "HEI Profile Schema",
      "description": "Complete profile schema for a Higher Education Institution on the CL Educate network",
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "title": "Role",
