{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aggregator forms — purple_dot/alimco",
  "description": "Form schemas the aggregator renders and validates against. Presentation lives in each schema under x-rjsf. Self-contained: a brand bundle repeats every form it serves, matching how network.json ships.",
  "forms": {
    "coordinator-registration": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://schemas.bluedots.org/aggregator/purple_dot/alimco/coordinator-registration.v1.json",
      "title": "Aggregator Registration",
      "description": "Signup payload for a new Aggregator account. Captures only the identity, contact, optional locations, and consent needed to create a Keycloak user and let the aggregator log in. Personas, services, verified certificates, and the contact-name label are filled in afterwards through the profile-completion flow.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "contact",
        "consent"
      ],
      "properties": {
        "name": {
          "type": "string",
          "title": "Organisation Name",
          "minLength": 2,
          "maxLength": 200,
          "examples": [
            "ABC Limited",
            "XYZ Foundation"
          ],
          "x-rjsf": {
            "placeholder": "e.g. ABC Limited",
            "autofocus": true
          }
        },
        "type": {
          "type": "string",
          "title": "Aggregator Type",
          "enum": [
            "seeker",
            "provider"
          ],
          "x-rjsf": {
            "widget": "select",
            "placeholder": "Select aggregator type",
            "enumNames": [
              "Seeker",
              "Service Provider"
            ]
          }
        },
        "sub_org_name": {
          "type": "string",
          "title": "Sub-Org / Division / Vertical / Institution Name",
          "description": "Any specific sub-identity needed for identification and tracking. May be the same as the organisation name.",
          "maxLength": 200,
          "x-updatable": true,
          "x-rjsf": {
            "placeholder": "e.g. branch, centre or division name"
          }
        },
        "url": {
          "type": "string",
          "title": "Website",
          "format": "uri",
          "maxLength": 2048,
          "examples": [
            "https://abclimited.org"
          ],
          "x-updatable": true,
          "x-rjsf": {
            "placeholder": "https://abclimited.org",
            "options": {
              "inputType": "url"
            }
          }
        },
        "locations": {
          "type": "array",
          "title": "Location",
          "maxItems": 1,
          "x-updatable": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "geo",
              "address"
            ],
            "properties": {
              "geo": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "coordinates"
                ],
                "default": {
                  "type": "Point",
                  "coordinates": [
                    0,
                    0
                  ]
                },
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "Point",
                      "LineString",
                      "Polygon",
                      "MultiPoint",
                      "MultiLineString",
                      "MultiPolygon",
                      "GeometryCollection"
                    ],
                    "default": "Point",
                    "x-rjsf": {
                      "widget": "hidden"
                    }
                  },
                  "coordinates": {
                    "type": "array",
                    "default": [
                      0,
                      0
                    ],
                    "x-rjsf": {
                      "widget": "hidden"
                    }
                  }
                },
                "x-rjsf": {
                  "widget": "hidden",
                  "title": ""
                }
              },
              "address": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "streetAddress": {
                    "type": "string",
                    "title": "Street",
                    "x-rjsf": {
                      "placeholder": "Street"
                    }
                  },
                  "addressLocality": {
                    "type": "string",
                    "title": "City",
                    "x-rjsf": {
                      "placeholder": "City"
                    }
                  },
                  "addressRegion": {
                    "type": "string",
                    "title": "State",
                    "x-rjsf": {
                      "placeholder": "State"
                    }
                  },
                  "postalCode": {
                    "type": "string",
                    "title": "PIN code",
                    "x-rjsf": {
                      "placeholder": "PIN"
                    }
                  },
                  "addressCountry": {
                    "type": "string",
                    "title": "Country",
                    "minLength": 1,
                    "x-rjsf": {
                      "placeholder": "India"
                    }
                  }
                },
                "x-rjsf": {
                  "layout": "grid",
                  "order": [
                    "streetAddress",
                    "addressLocality",
                    "addressRegion",
                    "postalCode",
                    "addressCountry"
                  ],
                  "title": ""
                }
              }
            },
            "x-rjsf": {
              "layout": "stack",
              "order": [
                "address",
                "geo"
              ],
              "title": ""
            }
          },
          "x-rjsf": {
            "options": {
              "addable": true,
              "removable": true,
              "orderable": false,
              "itemLabel": "Location"
            }
          }
        },
        "contact": {
          "type": "object",
          "title": "Primary Contact",
          "additionalProperties": false,
          "required": [
            "name",
            "phone",
            "email"
          ],
          "properties": {
            "name": {
              "type": "string",
              "title": "Contact Name",
              "minLength": 2,
              "maxLength": 200,
              "examples": [
                "Rajesh Kumar"
              ],
              "x-rjsf": {
                "placeholder": "Full name of the primary contact"
              }
            },
            "phone": {
              "type": "string",
              "title": "Phone",
              "pattern": "^(\\+?\\d{10,15}|\\d{10})$",
              "examples": [
                "+919876543210",
                "9876543210"
              ],
              "x-rjsf": {
                "placeholder": "+91 98765 43210",
                "options": {
                  "inputType": "tel"
                }
              }
            },
            "email": {
              "type": "string",
              "title": "Email",
              "format": "email",
              "maxLength": 320,
              "examples": [
                "admin@abclimited.org"
              ],
              "x-rjsf": {
                "placeholder": "admin@yourorg.in",
                "options": {
                  "inputType": "email"
                }
              }
            }
          },
          "x-rjsf": {
            "layout": "grid",
            "order": [
              "name",
              "phone",
              "email"
            ]
          }
        },
        "consent": {
          "type": "object",
          "title": "Terms & Privacy Consent",
          "additionalProperties": false,
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "boolean",
              "title": "I have read and accept the terms and privacy policy",
              "x-rjsf": {
                "widget": "ConsentCheckbox"
              }
            },
            "given_at": {
              "type": "string",
              "format": "date-time",
              "x-rjsf": {
                "widget": "hidden",
                "options": {
                  "label": false
                }
              }
            },
            "valid_till": {
              "type": "string",
              "format": "date-time",
              "x-rjsf": {
                "widget": "hidden",
                "options": {
                  "label": false
                }
              }
            }
          },
          "x-rjsf": {
            "layout": "stack",
            "order": [
              "value",
              "given_at",
              "valid_till"
            ]
          }
        }
      },
      "x-rjsf": {
        "layout": "stack",
        "order": [
          "name",
          "type",
          "sub_org_name",
          "url",
          "contact",
          "locations",
          "consent"
        ]
      }
    },
    "org-registration": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://schemas.bluedots.org/aggregator/purple_dot/alimco/org-registration.v1.json",
      "title": "Organisation Registration",
      "description": "Signup payload for a new parent organisation (spec §6.1). Captures the org display name, optional state, the org owner's contact identity, and consent. The URL slug is generated by the server at submit and is not supplied by the client. Coordinators register separately and select an approved org.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display_name",
        "aggregator_type",
        "organisation_type",
        "owner",
        "consent"
      ],
      "properties": {
        "display_name": {
          "type": "string",
          "title": "Organisation Name",
          "minLength": 2,
          "maxLength": 200,
          "examples": [
            "ABC Limited",
            "XYZ Foundation"
          ],
          "x-rjsf": {
            "placeholder": "e.g. ABC Limited",
            "autofocus": true
          }
        },
        "website": {
          "type": "string",
          "title": "Website",
          "format": "uri",
          "maxLength": 2048,
          "description": "Not required at signup; can be added or edited later.",
          "examples": [
            "https://abclimited.org"
          ],
          "x-updatable": true,
          "x-rjsf": {
            "placeholder": "https://yourorg.org",
            "options": {
              "inputType": "url"
            }
          }
        },
        "aggregator_type": {
          "type": "array",
          "title": "Aggregator Type",
          "description": "Which participants this organisation represents. Captured as information only — it does not restrict what its coordinators can do.",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "seeker",
              "provider"
            ]
          },
          "examples": [
            [
              "seeker"
            ],
            [
              "provider"
            ],
            [
              "seeker",
              "provider"
            ]
          ],
          "x-rjsf": {
            "enumNames": [
              "Seekers",
              "Service Providers"
            ]
          }
        },
        "organisation_type": {
          "type": "string",
          "title": "Organisation Type",
          "description": "The broad category that describes your organisation.",
          "enum": [
            "ngo",
            "government_entity",
            "private_company",
            "community_group",
            "other"
          ],
          "x-rjsf": {
            "widget": "select",
            "placeholder": "Select organisation type",
            "enumNames": [
              "NGO",
              "Government Entity",
              "Private Company",
              "Community Group",
              "Others"
            ]
          }
        },
        "address": {
          "type": "object",
          "title": "Address",
          "description": "Street onwards for the organisation.",
          "additionalProperties": false,
          "properties": {
            "streetAddress": {
              "type": "string",
              "title": "Street",
              "maxLength": 300,
              "x-rjsf": {
                "placeholder": "Street, Area"
              }
            },
            "addressLocality": {
              "type": "string",
              "title": "City",
              "maxLength": 200,
              "x-rjsf": {
                "placeholder": "City"
              }
            },
            "addressDistrict": {
              "type": "string",
              "title": "District",
              "maxLength": 200,
              "x-rjsf": {
                "placeholder": "District"
              }
            },
            "addressRegion": {
              "type": "string",
              "title": "State",
              "maxLength": 200,
              "x-rjsf": {
                "placeholder": "State"
              }
            },
            "postalCode": {
              "type": "string",
              "title": "PIN code",
              "maxLength": 20,
              "x-rjsf": {
                "placeholder": "PIN"
              }
            },
            "addressCountry": {
              "type": "string",
              "title": "Country",
              "maxLength": 100,
              "x-rjsf": {
                "placeholder": "India"
              }
            }
          },
          "x-rjsf": {
            "layout": "grid",
            "order": [
              "streetAddress",
              "addressLocality",
              "addressDistrict",
              "addressRegion",
              "postalCode",
              "addressCountry"
            ]
          }
        },
        "state": {
          "type": "string",
          "title": "State",
          "description": "Derived from the address block on this instance; not asked for separately.",
          "maxLength": 200,
          "x-rjsf": {
            "widget": "hidden",
            "options": {
              "label": false
            }
          }
        },
        "owner": {
          "type": "object",
          "title": "Organisation Owner",
          "additionalProperties": false,
          "required": [
            "name",
            "phone",
            "email"
          ],
          "properties": {
            "name": {
              "type": "string",
              "title": "Owner Name",
              "minLength": 2,
              "maxLength": 200,
              "examples": [
                "Rajesh Kumar"
              ],
              "x-rjsf": {
                "placeholder": "Full name of the organisation owner"
              }
            },
            "phone": {
              "type": "string",
              "title": "Phone",
              "pattern": "^(\\+?\\d{10,15}|\\d{10})$",
              "examples": [
                "+919876543210",
                "9876543210"
              ],
              "x-rjsf": {
                "placeholder": "+91 98765 43210",
                "options": {
                  "inputType": "tel"
                }
              }
            },
            "email": {
              "type": "string",
              "title": "Email",
              "format": "email",
              "maxLength": 320,
              "examples": [
                "owner@abclimited.org"
              ],
              "x-rjsf": {
                "placeholder": "owner@yourorg.org",
                "options": {
                  "inputType": "email"
                }
              }
            }
          },
          "x-rjsf": {
            "layout": "grid",
            "order": [
              "name",
              "phone",
              "email"
            ]
          }
        },
        "consent": {
          "type": "object",
          "title": "Terms & Privacy Consent",
          "additionalProperties": false,
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "boolean",
              "title": "I have read and accept the terms and privacy policy",
              "x-rjsf": {
                "widget": "ConsentCheckbox"
              }
            },
            "given_at": {
              "type": "string",
              "format": "date-time",
              "x-rjsf": {
                "widget": "hidden",
                "options": {
                  "label": false
                }
              }
            },
            "valid_till": {
              "type": "string",
              "format": "date-time",
              "x-rjsf": {
                "widget": "hidden",
                "options": {
                  "label": false
                }
              }
            }
          },
          "x-rjsf": {
            "layout": "stack",
            "order": [
              "value",
              "given_at",
              "valid_till"
            ]
          }
        }
      },
      "x-rjsf": {
        "layout": "stack",
        "order": [
          "display_name",
          "website",
          "aggregator_type",
          "organisation_type",
          "address",
          "state",
          "owner",
          "consent"
        ]
      }
    },
    "profile": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://schemas.bluedots.org/aggregator/purple_dot/alimco/profile.v1.json",
      "title": "Aggregator Profile",
      "description": "Post-login profile completion payload. Captures who the aggregator is, what they want from the network, and what they bring to it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "who_i_am",
        "what_i_want",
        "what_i_have"
      ],
      "properties": {
        "who_i_am": {
          "type": "object",
          "title": "Who I Am",
          "additionalProperties": false,
          "required": [
            "display_name",
            "address"
          ],
          "properties": {
            "display_name": {
              "type": "string",
              "title": "Display Name",
              "description": "Public display name shown on the network.",
              "minLength": 2,
              "maxLength": 200,
              "x-rjsf": {
                "placeholder": "Public display name"
              }
            },
            "address": {
              "type": "string",
              "title": "Office Address",
              "minLength": 5,
              "maxLength": 500,
              "x-rjsf": {
                "widget": "textarea",
                "options": {
                  "rows": 3
                }
              }
            },
            "logo_url": {
              "type": "string",
              "title": "Logo URL",
              "format": "uri",
              "maxLength": 500,
              "x-rjsf": {
                "placeholder": "https://...",
                "options": {
                  "inputType": "url"
                }
              }
            }
          }
        },
        "what_i_want": {
          "type": "object",
          "title": "What I Want",
          "additionalProperties": false,
          "required": [
            "beneficiary_groups",
            "geographies"
          ],
          "properties": {
            "beneficiary_groups": {
              "type": "array",
              "title": "Beneficiary Groups",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "minItems": 1,
              "maxItems": 12,
              "x-rjsf": {
                "options": {
                  "addable": true,
                  "removable": true
                }
              }
            },
            "geographies": {
              "type": "array",
              "title": "Geographies Served",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "minItems": 1,
              "maxItems": 36,
              "x-rjsf": {
                "options": {
                  "addable": true,
                  "removable": true
                }
              }
            },
            "sectors": {
              "type": "array",
              "title": "Sectors of Interest",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "maxItems": 24,
              "x-rjsf": {
                "options": {
                  "addable": true,
                  "removable": true
                }
              }
            }
          }
        },
        "what_i_have": {
          "type": "object",
          "title": "What I Have",
          "additionalProperties": false,
          "required": [
            "network_size"
          ],
          "properties": {
            "network_size": {
              "type": "integer",
              "title": "Approximate Network Size",
              "minimum": 0,
              "maximum": 10000000,
              "x-rjsf": {
                "placeholder": "0"
              }
            },
            "capabilities": {
              "type": "array",
              "title": "Capabilities Offered",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "maxItems": 24,
              "x-rjsf": {
                "options": {
                  "addable": true,
                  "removable": true
                }
              }
            }
          }
        },
        "consent": {
          "type": "object",
          "title": "Consent",
          "additionalProperties": false,
          "properties": {
            "profile_creation": {
              "type": "boolean",
              "title": "Profile creation & representation",
              "x-rjsf": {
                "widget": "checkbox"
              }
            },
            "data_sharing": {
              "type": "boolean",
              "title": "Sharing information with relevant parties",
              "x-rjsf": {
                "widget": "checkbox"
              }
            },
            "notifications": {
              "type": "boolean",
              "title": "Receive notifications",
              "x-rjsf": {
                "widget": "checkbox"
              }
            },
            "analytics": {
              "type": "boolean",
              "title": "Anonymous analytics",
              "x-rjsf": {
                "widget": "checkbox"
              }
            },
            "marketing": {
              "type": "boolean",
              "title": "Marketing communications",
              "x-rjsf": {
                "widget": "checkbox"
              }
            },
            "retention": {
              "type": "boolean",
              "title": "Data retention per policy",
              "x-rjsf": {
                "widget": "checkbox"
              }
            }
          }
        }
      },
      "x-rjsf": {
        "order": [
          "who_i_am",
          "what_i_want",
          "what_i_have",
          "consent"
        ]
      }
    }
  }
}
