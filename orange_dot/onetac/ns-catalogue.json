      "body_html": "\n  <div style=\"font-family: Arial, sans-serif; font-size: 15px; color: #333;\">\n    <p>Hi!</p>\n    <p>Hi!</p><p>Your details have been added to {{networkName}} by {{aggregatorOrg}}.</p><p>Please visit the app to activate your account and start offering your services near you.</p>\n    <p style=\"margin: 20px 0;\">\n      <a href=\"{{ctaUrl}}\" style=\"background-color:#ea580c;color:#ffffff;text-decoration:none;padding:10px 18px;border-radius:6px;display:inline-block;\">Activate your account</a>\n    </p>\n    <p style=\"font-size:13px;color:#555;\">Or open this link: <a href=\"{{ctaUrl}}\" style=\"color:#ea580c;\">{{ctaUrl}}</a></p>\n    <p style=\"margin-top:24px;\">Thanks,<br/>Team {{teamName}}</p>\n  </div>",
      "channel": "email",
      "subject": "Your account is ready — activate it to get started",
      "template_key": "account.aggregator_init.provider",
      "variables": [
        {
          "name": "aggregatorOrg",
          "required": true,
          "type": "string"
        },
        {
          "name": "ctaUrl",
          "required": true,
          "type": "url"
        },
        {
          "name": "networkName",
          "required": true,
          "type": "string"
        },
        {
          "name": "teamName",
          "required": true,
          "type": "string"
        }
      ]
    },
